    {
      "name": "08 Monthly Reports & Ratings",
      "item": [
        {
          "name": "POST Create Monthly Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/monthly-reports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mahallaId\": \"{{mahallaId}}\",\n  \"month\": \"{{reportMonth}}\",\n  \"summary\": \"Postman generated monthly summary\",\n  \"status\": \"SUBMITTED\",\n  \"items\": [\n    {\n      \"workName\": \"Cleanup campaign\",\n      \"workDate\": \"{{workDateIso}}\",\n      \"resultText\": \"Neighborhood cleanup completed.\",\n      \"evidenceMediaIds\": [\n        \"{{mediaId}}\"\n      ]\n    }\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const month = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, \"0\")}`;",
                  "pm.environment.set(\"reportMonth\", month);",
                  "pm.environment.set(\"workDateIso\", now.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
